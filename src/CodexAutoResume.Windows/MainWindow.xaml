<Window x:Class="CodexAutoResume.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex AutoResume" Width="800" Height="820" MinWidth="700" MinHeight="560"
 Closing="OnClosing" StateChanged="OnWindowStateChanged">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <Button x:Name="Toggle" DockPanel.Dock="Right" Content="○ OFF" Click="ToggleClick" Width="100" AutomationProperties.Name="Automatic scheduling"/>
      <StackPanel><TextBlock Text="Codex AutoResume" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Exact sessions. Durable queue. Explicit ownership." Foreground="#99ABC5"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#1A2435" CornerRadius="8" Padding="12" Margin="0,14,0,8">
      <StackPanel>
        <TextBlock Text="Desktop control and UI synchronization are not supported. Close Desktop and other Codex clients before connecting." Foreground="#F6C879"/>
        <DockPanel Margin="0,6,0,0">
          <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect" Click="ConnectClick"/>
          <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="BrowseCodexClick"/>
          <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find Codex" Click="FindCodexClick"/>
          <TextBox x:Name="CodexPath" ToolTip="Codex is detected automatically, including npm installs. You can also choose a native codex.exe." AutomationProperties.Name="Codex executable path"/>
        </DockPanel>
        <CheckBox x:Name="Exclusive" Content="I grant AutoResume exclusive ownership of the selected sessions. Other clients will remain closed."/>
        <TextBlock x:Name="Connection" Text="Disconnected · scheduling is OFF until connected and revalidated" Foreground="#99ABC5"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2">
      <DockPanel><Button DockPanel.Dock="Right" Content="+ Add conversation" Click="AddClick"/><TextBlock x:Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
      <TextBlock x:Name="Usage" Text="Usage: not yet checked" Foreground="#99ABC5" Margin="3,3,0,8"/>
    </StackPanel>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="Empty" Margin="10,20" Foreground="#99ABC5" Text="Connect, then select up to five existing conversations. Completed work stays completed until you explicitly rearm it."/>
        <ItemsControl x:Name="Cards">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1A2435" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#2B3A51" BorderThickness="1">
                <StackPanel>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{Binding BadgeBrush}" CornerRadius="9" Padding="9,3" Margin="6,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,5,0">
                          <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0.7"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><DataTrigger.EnterActions><BeginStoryboard Name="RunningPulse"><Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RunningPulse"/></DataTrigger.ExitActions></DataTrigger></Style.Triggers>
                          </Style></Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="12"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Heading}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" Foreground="#99ABC5" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding Workspace}" FontSize="11" Foreground="#99ABC5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Workspace}"/>
                  <TextBlock Text="{Binding Timing}" Foreground="#B8CFFF" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding Reason}" Foreground="#BAC6D8" Margin="0,2,0,4"/>
                  <WrapPanel>
                    <Button Content="↑" Tag="{Binding Id}" Click="UpClick" ToolTip="Higher priority" AutomationProperties.Name="Higher priority"/>
                    <Button Content="↓" Tag="{Binding Id}" Click="DownClick" ToolTip="Lower priority" AutomationProperties.Name="Lower priority"/>
                    <Button Content="{Binding ParallelLabel}" Tag="{Binding Id}" Click="ParallelClick" ToolTip="Star permits parallel execution in independent repositories"/>
                    <Button Content="{Binding PauseLabel}" Tag="{Binding Id}" Click="PauseClick" ToolTip="Pause future scheduling; active execution continues"/>
                    <Button Content="Retry / rearm" Tag="{Binding Id}" Click="RetryClick"/>
                    <Button Content="Prompt…" Tag="{Binding Id}" Click="PromptClick"/>
                    <Button Content="Remove" Tag="{Binding Id}" Click="RemoveClick"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Header="Recent activity" Foreground="#CBD8EC" IsExpanded="True" Margin="0,8,0,0">
          <TextBox x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="4" Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" Content="Hide to tray" Click="HideClick"/>
      <CheckBox x:Name="Startup" Content="Start with Windows (tray)" Click="StartupClick"/>
    </DockPanel>
  </Grid>
</Window>
