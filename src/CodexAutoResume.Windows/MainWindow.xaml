<Window x:Class="CodexAutoResume.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Codex AutoResume" Width="1020" Height="830" MinWidth="620" MinHeight="500"
 Closing="OnClosing" StateChanged="OnWindowStateChanged">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="20">
  <DockPanel Margin="0,0,0,18">
   <Button x:Name="Toggle" DockPanel.Dock="Right" Content="○ OFF" Click="ToggleClick" MinWidth="102" BorderBrush="{DynamicResource AccentText}" AutomationProperties.Name="Automatic scheduling" ToolTip="Master scheduling preference. Connection and ownership are checked separately."/>
   <TextBlock x:Name="TerminalMark" Text="&gt;_" FontFamily="Consolas" FontSize="28" Foreground="{DynamicResource AccentText}" Margin="0,0,14,0" VerticalAlignment="Center"/>
   <StackPanel><TextBlock Text="Codex AutoResume" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionBadge" Text="DISCONNECTED" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Border Style="{StaticResource Panel}" BorderBrush="{DynamicResource AccentFocus}">
   <StackPanel>
    <TextBlock Text="01 / WATCHER" Style="{StaticResource Caption}"/>
    <TextBlock x:Name="WatcherHeading" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="NextAction" Foreground="{DynamicResource Secondary}" Margin="0,5,0,8"/>
    <TextBlock x:Name="Usage" Foreground="{DynamicResource Attention}"/>
    <Border x:Name="ConnectionErrorPanel" Background="{DynamicResource Elevated}" BorderBrush="{DynamicResource Failure}" BorderThickness="2,0,0,0" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
     <StackPanel><TextBlock Text="CONNECTION ERROR" Foreground="{DynamicResource Failure}" FontWeight="SemiBold"/><TextBox x:Name="ConnectionError" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Connection error details"/></StackPanel>
    </Border>
   </StackPanel>
  </Border>
  <UniformGrid Columns="4" Margin="0,0,0,12">
   <StackPanel><TextBlock Text="RUNNING" Style="{StaticResource Caption}"/><TextBlock x:Name="RunningCount" Text="0" FontSize="26" FontFamily="Consolas"/></StackPanel>
   <StackPanel><TextBlock Text="QUEUED" Style="{StaticResource Caption}"/><TextBlock x:Name="QueuedCount" Text="0" FontSize="26" FontFamily="Consolas"/></StackPanel>
   <StackPanel><TextBlock Text="RATE LIMITED" Style="{StaticResource Caption}"/><TextBlock x:Name="LimitedCount" Text="0" FontSize="26" FontFamily="Consolas" Foreground="{DynamicResource Attention}"/></StackPanel>
   <StackPanel><TextBlock Text="COMPLETED" Style="{StaticResource Caption}"/><TextBlock x:Name="CompletedCount" Text="0" FontSize="26" FontFamily="Consolas" Foreground="{DynamicResource Success}"/></StackPanel>
  </UniformGrid>
  <DockPanel Margin="0,0,0,6"><Button x:Name="AddButton" DockPanel.Dock="Right" Content="+ _Add conversation" Click="AddClick"/><StackPanel><TextBlock Text="02 / PRIORITY QUEUE" Style="{StaticResource Caption}"/><TextBlock x:Name="Summary" Foreground="{DynamicResource Secondary}" FontSize="11"/></StackPanel></DockPanel>
  <Border x:Name="EmptyPanel" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Keep your work moving." FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Empty" Margin="0,6,0,0" Foreground="{DynamicResource Secondary}" Text="Your five most recent chats appear automatically when the queue is empty. Existing priorities stay fixed. Desktop may remain open while browsing."/></StackPanel></Border>
  <ItemsControl x:Name="Cards"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Style="{StaticResource Panel}"><StackPanel>
    <DockPanel>
     <Border DockPanel.Dock="Right" Background="{Binding BadgeBrush}" CornerRadius="3" Padding="8,4" Margin="8,0,0,0"><StackPanel Orientation="Horizontal">
      <Ellipse Width="5" Height="5" Fill="White" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0.85"/><Style.Triggers>
       <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRunning}" Value="True"/><Condition Binding="{Binding MotionEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions><BeginStoryboard Name="RunningPulse"><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:0.16" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions><MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="RunningPulse"/></MultiDataTrigger.ExitActions>
       </MultiDataTrigger>
      </Style.Triggers></Style></Ellipse.Style></Ellipse>
      <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="11"/>
     </StackPanel></Border>
     <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Heading}"/>
    </DockPanel>
    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Secondary}" Margin="0,7,0,0"/>
    <TextBlock Text="{Binding Workspace}" FontSize="11" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Workspace}"/>
    <TextBlock Text="{Binding Timing}" Foreground="{DynamicResource AccentText}" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource Secondary}" Margin="0,3,0,6"/>
    <WrapPanel>
     <Button Content="↑" Tag="{Binding Id}" Click="UpClick" ToolTip="Higher priority" AutomationProperties.Name="Higher priority"/>
     <Button Content="↓" Tag="{Binding Id}" Click="DownClick" ToolTip="Lower priority" AutomationProperties.Name="Lower priority"/>
     <Button Content="{Binding ParallelLabel}" Tag="{Binding Id}" Click="ParallelClick" ToolTip="Permit simultaneous execution in independent repositories"/>
     <Button Content="{Binding PauseLabel}" Tag="{Binding Id}" Click="PauseClick" ToolTip="Pause future scheduling; active execution continues"/>
     <Button Content="Retry / rearm" Tag="{Binding Id}" Click="RetryClick"/><Button Content="Prompt…" Tag="{Binding Id}" Click="PromptClick"/><Button Content="Remove" Tag="{Binding Id}" Click="RemoveClick"/>
    </WrapPanel>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Border Style="{StaticResource Panel}"><Expander x:Name="ConnectionSettings" Header="03 / CONNECTION &amp; SETTINGS" IsExpanded="True"><StackPanel Margin="0,12,0,0">
   <TextBlock Text="Desktop may stay open for connection and chat discovery. Desktop UI synchronization is unsupported. Close other clients only when handing over execution ownership." Foreground="{DynamicResource Attention}"/>
   <TextBlock Text="Native Codex executable · resolved path" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
   <TextBox x:Name="CodexPath" FontFamily="Consolas" TextChanged="CodexPathChanged" ToolTip="Detected automatically, including npm installs. Browse to override." AutomationProperties.Name="Codex executable path"/>
   <WrapPanel><Button x:Name="FindButton" Content="_Re-detect" Click="FindCodexClick"/><Button x:Name="BrowseButton" Content="_Browse…" Click="BrowseCodexClick"/><Button x:Name="ConnectButton" Content="_Connect read-only" Click="ConnectClick" BorderBrush="{DynamicResource AccentFocus}"/><TextBlock x:Name="DetectedVersion" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/></WrapPanel>
   <TextBlock x:Name="Detection" Text="Detecting Codex…" Foreground="{DynamicResource Secondary}" Margin="0,3,0,4"/>
   <CheckBox x:Name="Exclusive"><TextBlock Text="For execution: other Codex clients are closed. I grant AutoResume exclusive ownership of these sessions."/></CheckBox>
   <WrapPanel><Button x:Name="AcquireButton" Content="Acquire execution ownership" Click="AcquireClick"/><Button x:Name="RefreshChatsButton" Content="Refresh chats" Click="RefreshChatsClick"/></WrapPanel>
   <TextBlock x:Name="Connection" Foreground="{DynamicResource Secondary}"/>
   <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="Startup" Content="Start with Windows (tray)" Click="StartupClick"/><CheckBox x:Name="MinimizeTray" Content="Minimize to tray" Click="AppearanceChanged"/><CheckBox x:Name="CloseTray" Content="Close to tray" Click="AppearanceChanged"/></WrapPanel>
   <WrapPanel><Button Content="Desktop shortcut" Click="ShortcutClick"/><Button Content="Hide to tray" Click="HideClick"/><Button Content="Exit" Click="ExitClick"/></WrapPanel>
  </StackPanel></Expander></Border>
  <Border Style="{StaticResource Panel}"><Expander Header="04 / THEME &amp; APPEARANCE"><StackPanel Margin="0,12,0,0">
   <TextBlock Text="ACCENT PRESET" Style="{StaticResource Caption}"/>
   <ComboBox x:Name="AccentPreset" SelectionChanged="PresetChanged" HorizontalAlignment="Left" Width="220" AutomationProperties.Name="Accent preset"/>
   <WrapPanel Margin="0,8,0,0"><TextBox x:Name="AccentHex" Width="110" MaxLength="7" FontFamily="Consolas" TextChanged="AccentChanged" AutomationProperties.Name="Accent HEX color"/><Button Content="Color picker…" Click="PickAccentClick"/><Button Content="Reset to Default" Click="ResetAppearanceClick"/><TextBlock Text="Accent preview" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/></WrapPanel>
   <TextBlock x:Name="AccentValidation" Foreground="{DynamicResource Attention}"/>
   <TextBlock Text="SuckerPunch Pink uses a preview placeholder. The original brand color is still needed." Foreground="{DynamicResource Secondary}" FontSize="11"/>
   <WrapPanel><CheckBox x:Name="ReduceMotion" Content="Reduce motion" Click="AppearanceChanged"/><CheckBox x:Name="ReduceGlow" Content="Reduce glow" Click="AppearanceChanged"/></WrapPanel>
   <TextBlock Text="Windows animation and high contrast preferences take priority. Health colors stay independent of the accent." Foreground="{DynamicResource Secondary}" FontSize="11"/>
  </StackPanel></Expander></Border>
  <Border Style="{StaticResource Panel}" Margin="0"><Expander x:Name="History" Header="05 / EVENT HISTORY"><StackPanel Margin="0,10,0,0"><TextBlock Text="Newest first · severity inferred from recorded messages. Select an event for full details." Foreground="{DynamicResource Secondary}" FontSize="11" Margin="0,0,0,6"/>
   <ListBox x:Name="Activity" MaxHeight="180" SelectionChanged="EventSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Severity}" Foreground="{Binding Color}" FontFamily="Consolas" DockPanel.Dock="Left" Width="52"/><TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <TextBox x:Name="EventDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected event details"/>
  </StackPanel></Expander></Border>
 </StackPanel>
 </ScrollViewer>
</Window>
