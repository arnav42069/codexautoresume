<Application x:Class="CodexAutoResume.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#10151F"/><Setter Property="Foreground" Value="#E8EDF6"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#273349"/><Setter Property="Foreground" Value="#F2F5FB"/>
      <Setter Property="BorderBrush" Value="#40516D"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3B4D6A"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#1C2638"/><Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="BorderBrush" Value="#40516D"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EDF6"/><Setter Property="Margin" Value="4,8"/></Style>
  </Application.Resources>
</Application>
